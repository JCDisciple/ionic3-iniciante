# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave pública VAPID para lembretes por notificação (npx web-push generate-vapid-keys).
# A chave privada vai só nos segredos da Edge Function loan-reminders.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# URL pública do PWA (usada nos links de convite enviados pelo app nativo).
EXPO_PUBLIC_APP_URL=
